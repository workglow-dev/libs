{
  "name": "@workglow/javascript",
  "type": "module",
  "sideEffects": [
    "./dist/task.js"
  ],
  "version": "0.6.6",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/libs.git",
    "directory": "packages/javascript"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "description": "Sandboxed JavaScript task with vendored interpreter.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "bun build --watch --no-clear-screen --sourcemap=external --packages=external --outdir ./dist ./src/task.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "bun run build-js && bun run build-types",
    "build-js": "bun build --sourcemap=external --packages=external --outdir ./dist ./src/task.ts",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc && mkdir -p dist/task && cp src/task/interpreter.d.ts dist/task/interpreter.d.ts"
  },
  "exports": {
    "./task": {
      "types": "./dist/task.d.ts",
      "import": "./dist/task.js"
    }
  },
  "peerDependencies": {
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@workglow/task-graph": {
      "optional": false
    },
    "@workglow/util": {
      "optional": false
    }
  },
  "devDependencies": {
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
