{
  "name": "@workglow/browser-control",
  "type": "module",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/libs.git",
    "directory": "packages/browser-control"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "description": "Browser-control tasks for Workglow (CDP base + IBrowserContext abstraction). Backends ship as separate provider packages: @workglow/playwright, @workglow/electron, @workglow/bun-webview.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "bun run watch-task",
    "watch-task": "bun build --watch --no-clear-screen --sourcemap=external --packages=external --outdir ./dist ./src/task.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "bun run build-js && bun run build-types",
    "build-js": "bun run build-task",
    "build-task": "bun build --sourcemap=external --packages=external --outdir ./dist ./src/task.ts",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc"
  },
  "exports": {
    "./task": {
      "types": "./dist/task.d.ts",
      "import": "./dist/task.js"
    }
  },
  "peerDependencies": {
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@workglow/task-graph": {
      "optional": false
    },
    "@workglow/util": {
      "optional": false
    }
  },
  "devDependencies": {
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
