{
  "name": "@workglow/tasks",
  "type": "module",
  "version": "0.6.6",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/libs.git",
    "directory": "packages/tasks"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "description": "Pre-built task implementations for Workglow, including common AI operations and utility functions.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "concurrently -c 'auto' -n 'browser,node,electron' 'bun run watch-browser' 'bun run watch-node' 'bun run watch-electron'",
    "watch-browser": "bun build --watch --no-clear-screen --target=browser --sourcemap=external --packages=external --outdir ./dist ./src/browser.ts",
    "watch-node": "bun build --watch --no-clear-screen --target=node --sourcemap=external --packages=external --outdir ./dist ./src/node.ts",
    "watch-electron": "bun build --watch --no-clear-screen --target=node --sourcemap=external --packages=external --outdir ./dist ./src/electron.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "concurrently -c 'auto' -n 'browser,node,electron,types' 'bun run build-browser' 'bun run build-node' 'bun run build-electron' 'bun run build-types'",
    "build-js": "concurrently -m 12 --timings -c 'auto' -n 'browser,node,electron' 'bun run build-browser' 'bun run build-node' 'bun run build-electron'",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-browser": "bun build --target=browser --sourcemap=external --packages=external --outdir ./dist ./src/browser.ts",
    "build-node": "bun build --target=node --sourcemap=external --packages=external --outdir ./dist ./src/node.ts",
    "build-electron": "bun build --target=node --sourcemap=external --packages=external --outdir ./dist ./src/electron.ts",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.2"
  },
  "peerDependencies": {
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*",
    "@workglow/job-queue": "workspace:*",
    "@workglow/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@workglow/task-graph": {
      "optional": false
    },
    "@workglow/util": {
      "optional": false
    },
    "@workglow/job-queue": {
      "optional": false
    },
    "@workglow/storage": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@workglow/job-queue": "workspace:*",
    "@workglow/storage": "workspace:*",
    "@workglow/task-graph": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "optionalDependencies": {
    "papaparse": "^5.7.0"
  }
}
