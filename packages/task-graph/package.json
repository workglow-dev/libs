{
  "name": "@workglow/task-graph",
  "type": "module",
  "version": "0.6.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/libs.git",
    "directory": "packages/task-graph"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "description": "Task graph management for Workglow, providing DAG construction, execution planning, and workflow orchestration.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "concurrently -c 'auto' -n 'browser,node,test' 'bun run watch-browser' 'bun run watch-node' 'bun run watch-test'",
    "watch-browser": "bun build --watch --no-clear-screen --target=browser --sourcemap=external --packages=external --outdir ./dist ./src/browser.ts",
    "watch-node": "bun build --watch --no-clear-screen --target=node --sourcemap=external --packages=external --outdir ./dist ./src/node.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "concurrently -c 'auto' -n 'browser,node,test,types' 'bun run build-browser' 'bun run build-node' 'bun run build-test' 'bun run build-types'",
    "build-js": "concurrently -m 12 --timings -c 'auto' -n 'browser,node,test' 'bun run build-browser' 'bun run build-node' 'bun run build-test'",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-browser": "bun build --target=browser --sourcemap=external --packages=external --outdir ./dist ./src/browser.ts",
    "build-node": "bun build --target=node --sourcemap=external --packages=external --outdir ./dist ./src/node.ts",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc",
    "build-test": "bun build --target=node --sourcemap=external --packages=external --outdir ./dist ./src/test-entry.ts",
    "test": "vitest run --config ../../vitest.config.ts --project task-graph",
    "watch-test": "bun build --watch --no-clear-screen --target=node --sourcemap=external --packages=external --outdir ./dist ./src/test-entry.ts"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./test": {
      "types": "./dist/test-entry.d.ts",
      "import": "./dist/test-entry.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@workglow/job-queue": "workspace:*",
    "@workglow/storage": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@workglow/job-queue": {
      "optional": false
    },
    "@workglow/storage": {
      "optional": false
    },
    "@workglow/util": {
      "optional": false
    }
  },
  "devDependencies": {
    "@workglow/job-queue": "workspace:*",
    "@workglow/storage": "workspace:*",
    "@workglow/util": "workspace:*"
  }
}
