{
  "name": "@workglow/duckdb",
  "type": "module",
  "version": "0.6.5",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/libs.git",
    "directory": "providers/duckdb"
  },
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "description": "DuckDB backends for @workglow/storage.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "concurrently -c 'auto' -n 'storage-br,storage-nb' 'bun run watch-storage-browser' 'bun run watch-storage-node-bun'",
    "watch-storage-browser": "bun build --watch --no-clear-screen --target=browser --sourcemap=external --packages=external --outdir ./dist/storage ./src/storage/browser.ts",
    "watch-storage-node-bun": "bun build --watch --no-clear-screen --target=node --sourcemap=external --packages=external --outdir ./dist/storage ./src/storage/node.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "bun run build-js && bun run build-types",
    "build-js": "concurrently -m 12 --timings -c 'auto' -n 'storage-br,storage-nb' 'bun run build-storage-browser' 'bun run build-storage-node-bun'",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-storage-browser": "bun build --target=browser --sourcemap=external --packages=external --outdir ./dist/storage ./src/storage/browser.ts",
    "build-storage-node-bun": "bun build --target=node --sourcemap=external --packages=external --outdir ./dist/storage ./src/storage/node.ts",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsc"
  },
  "exports": {
    "./storage": {
      "browser": {
        "types": "./dist/storage/browser.d.ts",
        "import": "./dist/storage/browser.js"
      },
      "types": "./dist/storage/node.d.ts",
      "import": "./dist/storage/node.js"
    }
  },
  "peerDependencies": {
    "@duckdb/node-api": "catalog:",
    "@workglow/storage": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    },
    "@workglow/storage": {
      "optional": false
    },
    "@workglow/util": {
      "optional": false
    }
  },
  "devDependencies": {
    "@duckdb/node-api": "catalog:",
    "@workglow/storage": "workspace:*",
    "@workglow/util": "workspace:*"
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
