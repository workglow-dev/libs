{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Plugins are the same set the ESLint config carried, minus the ones with no
  // oxlint counterpart. `plugins` REPLACES oxlint's default set, so `unicorn`
  // and `oxc` are off here on purpose: they are rule families this repo has
  // never linted against, they report ~65 findings on a tree that is otherwise
  // clean, and adopting them is a change worth evaluating on its own rather
  // than a side effect of swapping linters.
  //
  // Gone with `eslint-plugin-regexp`, which oxlint has no equivalent for: 60
  // rules, of which `no-super-linear-backtracking` (the ReDoS guard) is the one
  // with no substitute. `correctness` below still covers `no-control-regex`,
  // `no-invalid-regexp`, `no-misleading-character-class`,
  // `no-empty-character-class`, `no-useless-backreference` and
  // `no-regex-spaces`; the optimisation and catastrophic-backtracking rules
  // have no replacement. `react/no-deprecated` is likewise gone;
  // `react/prop-types` is too and is no loss in a TypeScript tree.
  "plugins": ["typescript", "react", "jsx-a11y"],

  // oxlint's own default category, and a superset of what `typescript-eslint`'s
  // `recommended` enabled here: that config never pulled in
  // `js.configs.recommended`, so plain `eslint:recommended` rules such as
  // `no-dupe-else-if`, `no-unsafe-finally` and `no-unsafe-optional-chaining`
  // were not running at all.
  "categories": { "correctness": "error" },

  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },

  "settings": {
    "react": { "version": "19.0" }
  },

  "ignorePatterns": [
    "**/dist",
    "**/storybook-static",
    "**/node_modules",
    // Vendored third-party sources (Google's JS-Interpreter and the acorn build
    // it ships with). The ESLint config only ever matched `.ts`/`.tsx`, so these
    // were never linted; oxlint reads `.js` too and reports 31 findings in code
    // this repo does not own.
    "packages/javascript/src/task/interpreter.js",
    "packages/javascript/src/task/acorn.js"
  ],

  "rules": {
    // ---------------------------------------------------------------------
    // Rules the ESLint config enabled that are NOT in oxlint's `correctness`
    // category. Listed so the migration is rule-for-rule rather than
    // "whatever the new linter happens to default to".
    // ---------------------------------------------------------------------
    "typescript/ban-ts-comment": "error",
    "typescript/no-array-constructor": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "react/display-name": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/require-render-return": "error",
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "error",
    "no-regex-spaces": "error",
    "prefer-regex-literals": "error",

    // `disallowTypeAnnotations` must stay off: inline `import()` types are how
    // optional peer dependencies are typed here (e.g. `typeof import("pg")`)
    // without forcing a static import that would break consumers who have not
    // installed the package. Turning it on flags those deliberate annotations,
    // and they are not autofixable.
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports",
        "disallowTypeAnnotations": false
      }
    ],

    // ---------------------------------------------------------------------
    // Type-aware rules run only under `oxlint --type-aware`, which shells out
    // to tsgolint. They need `dist/*.d.ts` to exist -- the packages resolve
    // each other through `exports`, so an unbuilt tree types every
    // cross-package import as `any` and these rules silently find nothing.
    // `bun run lint` and the CI lint job both build types first.
    //
    // Everything type-aware in `correctness` is ON. Eight of these were once
    // staged off against a counted budget, and the tree passes all eight now.
    // The two still off are off by POLICY, not debt: their findings are
    // idiomatic here and would only ever buy disable comments on correct code,
    // so each carries its reason below instead of a number. Staging a further
    // rule off means writing the same kind of reason -- there is no longer a
    // count to hide behind.
    // ---------------------------------------------------------------------
    "typescript/no-base-to-string": "error",
    // 62 findings, none of them a defect: 31 are `expect(spy.method)` style
    // assertions that never call the method, 9 read an optional member out so
    // they can `.call(receiver)` it after a typeof probe, 10 are `own`/`disown`
    // which TaskRunner's constructor rebinds, 7 save a prototype method to
    // restore after a test monkey-patches it, and 5 are statics that touch no
    // `this`. Enabling it would buy 62 disable comments on correct code, each
    // one a liability under --report-unused-disable-directives, so it stays
    // off.
    "typescript/unbound-method": "off",
    "typescript/no-floating-promises": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/await-thenable": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/no-useless-default-assignment": "error",
    "typescript/no-misused-spread": "error",
    // 9 findings, all "explicit undefined is unnecessary on an optional
    // parameter" -- which is the house style (`T | undefined` over `T?`), not a
    // defect. This one stays off rather than waiting for a cleanup.
    "typescript/no-duplicate-type-constituents": "off",

    // ---------------------------------------------------------------------
    // Off, for the same reasons they were off under ESLint.
    // ---------------------------------------------------------------------
    // `noUnusedLocals` in tsconfig.json already covers this one.
    "no-unused-vars": "off",
    // `any` in generics is explicitly sanctioned by the code style.
    "typescript/no-explicit-any": "off",
    "react/react-in-jsx-scope": "off",

    // NOT part of `eslint-plugin-jsx-a11y`'s recommended set, which is what this
    // repo linted against; oxlint puts it in `correctness`. Keeping it on adds
    // five findings ESLint never reported.
    "jsx-a11y/prefer-tag-over-role": "off"
  },

  "overrides": [
    {
      // Root build/dev scripts, which ESLint never reached -- its `files` globs
      // only covered `{packages,providers,examples}/**`. They lint clean apart
      // from the React plugin, which reads `useSource()` / `useDist()` in
      // `bunsrc-workspace.ts` as hooks called outside a component.
      "files": ["scripts/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "react/exhaustive-deps": "off"
      }
    },
    {
      // Provider `src/ai/common/**` files are re-exported from each provider's
      // `runtime.ts`, so they are evaluated inside worker bundles.
      //
      // Restricted by NAME rather than by path: several files in this directory
      // legitimately import error classes and task types the worker barrel does
      // not re-export yet, and a path-wide restriction would only buy a wall of
      // disable comments.
      //
      // `allowTypeImports` keeps `import type { ModelEffort } from
      // "@workglow/ai"` legal, which matters because those types sit beside
      // every one of these value imports.
      "files": ["providers/*/src/ai/common/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@workglow/ai",
                "importNames": [
                  "MODEL_EFFORTS",
                  "isModelEffort",
                  "sanitizeEffortOptions",
                  "readEffortOptions",
                  "stampEffortOptions",
                  "enabledEffortsForModel",
                  "effortPlaceholder"
                ],
                "allowTypeImports": true,
                "message": "Import effort helpers from @workglow/ai/worker. The root barrel pulls all task classes and a second copy of AiProviderRegistry / CheckpointRegistry into the worker bundle."
              }
            ]
          }
        ]
      }
    },
    {
      // `*_JobRunFns.ts` files execute inside workers, which have an isolated
      // runtime with their own `globalServiceRegistry`. Importing main-thread-only
      // state (the global service registry or credential stores) resolves against
      // a different, empty registry at runtime. Resolve such state in the task
      // class on the main thread and pass it through the serialized job input
      // instead.
      //
      // Must stay AFTER the `src/ai/common/**` block and repeat its paths: every
      // run-fn in the repo also lives in that directory, and a later override
      // REPLACES a rule's options rather than merging them.
      "files": ["**/*_JobRunFns.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@workglow/util",
                "importNames": [
                  "globalServiceRegistry",
                  "getGlobalCredentialStore",
                  "setGlobalCredentialStore"
                ],
                "message": "Main-thread-only state is unavailable in workers. Resolve it in the task class (e.g. AiTask.getJobInput()) and pass it through the serialized job input."
              },
              {
                "name": "@workglow/util/worker",
                "importNames": ["globalServiceRegistry"],
                "message": "Main-thread-only state is unavailable in workers. Resolve it in the task class (e.g. AiTask.getJobInput()) and pass it through the serialized job input."
              },
              {
                "name": "@workglow/ai",
                "importNames": [
                  "MODEL_EFFORTS",
                  "isModelEffort",
                  "sanitizeEffortOptions",
                  "readEffortOptions",
                  "stampEffortOptions",
                  "enabledEffortsForModel",
                  "effortPlaceholder"
                ],
                "allowTypeImports": true,
                "message": "Import effort helpers from @workglow/ai/worker. The root barrel pulls all task classes and a second copy of AiProviderRegistry / CheckpointRegistry into the worker bundle."
              },
              // Only `bootstrapWorkglow` touches the global registry.
              // `createOrchestrationContext` builds a fresh `Container`, and
              // `registerAllDefaults(registry)` mutates only what it is handed —
              // both legitimate against a registry the run-fn owns.
              {
                "name": "@workglow/bootstrap",
                "importNames": ["bootstrapWorkglow"],
                "message": "A run-fn executes in a worker with its own globalServiceRegistry, so bootstrapWorkglow mutates a registry the main thread never sees. Resolve the services in the task class (e.g. AiTask.getJobInput()) and pass them through the serialized job input."
              },
              {
                "name": "workglow/bootstrap",
                "importNames": ["bootstrapWorkglow"],
                "message": "A run-fn executes in a worker with its own globalServiceRegistry, so bootstrapWorkglow mutates a registry the main thread never sees. Resolve the services in the task class (e.g. AiTask.getJobInput()) and pass them through the serialized job input."
              },
              // `packages/workglow/src/common.ts` does `export * from
              // "./bootstrap"` and also re-exports `@workglow/util`, so every name
              // restricted above is one specifier away through the root barrel.
              {
                "name": "workglow",
                "importNames": [
                  "bootstrapWorkglow",
                  "globalServiceRegistry",
                  "getGlobalCredentialStore",
                  "setGlobalCredentialStore"
                ],
                "message": "The workglow root barrel re-exports both @workglow/bootstrap and @workglow/util. Main-thread-only state is unavailable in workers. Resolve it in the task class (e.g. AiTask.getJobInput()) and pass it through the serialized job input."
              }
            ]
          }
        ]
      }
    }
  ]
}
